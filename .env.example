# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# Required to email contact-form submissions. Get one at https://resend.com/api-keys
# If unset, submissions are logged to the server console instead.
RESEND_API_KEY=

# Optional: inbox that receives submissions (defaults to contact.email in src/config/site.ts).
CONTACT_TO_EMAIL=

# Optional: sender address. Must be on a domain you have verified in Resend,
# e.g. "Picabord Website <website@yourdomain.com>".
# Defaults to Resend's test sender (onboarding@resend.dev), which can only deliver
# to the email address that owns your Resend account.
CONTACT_FROM_EMAIL=

# Optional: canonical site URL used for metadata, sitemap and robots.txt,
# e.g. https://www.picabord.com. On Vercel it falls back to the production domain.
NEXT_PUBLIC_SITE_URL=
